{
  // Deploy with: npm run deploy (uses `wrangler pages deploy dist`)
  // Do NOT use `wrangler deploy` — that's for Workers, not Pages.
  "name": "domnotate",
  "compatibility_date": "2026-03-30",
  "pages_build_output_dir": "./dist",
  "r2_buckets": [
    {
      "binding": "SHARES",
      "bucket_name": "domnotate-shares"
    }
  ]
}
